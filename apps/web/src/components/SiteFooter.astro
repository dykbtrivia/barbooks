---
interface Props {
  currentPage?: number;
  totalPages?: number;
}

const { currentPage = 1, totalPages = 100 } = Astro.props as Props;
---

<footer class="bg-ink text-cream mt-auto print:hidden">
  <div class="container mx-auto px-4 py-6">
    <div class="flex justify-between items-center">
      <p class="font-mono text-xs uppercase tracking-widest text-cream-dark">&copy; 2024 Do You Know Ball?</p>

      <!-- Center section for QR code (added by JS) and page number -->
      <div id="footer-center" class="flex items-center space-x-4">
        <span class="text-cream-dark text-sm font-mono">Page {currentPage}</span>
      </div>

      <div class="flex space-x-2">
        <button
          id="prev-btn"
          class={`px-4 py-2 font-display text-sm uppercase tracking-wide transition-colors duration-200 ${
            currentPage <= 1
              ? 'bg-ink-soft text-light cursor-not-allowed'
              : 'bg-red hover:bg-red-dark text-cream'
          }`}
          disabled={currentPage <= 1}
        >
          ← Previous
        </button>
        <button
          id="next-btn"
          class={`px-4 py-2 font-display text-sm uppercase tracking-wide transition-colors duration-200 ${
            currentPage >= totalPages
              ? 'bg-ink-soft text-light cursor-not-allowed'
              : 'bg-red hover:bg-red-dark text-cream'
          }`}
          disabled={currentPage >= totalPages}
        >
          Next →
        </button>
      </div>
    </div>
  </div>
</footer>