---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
// Swap between header designs:
// import PageHeader from '../components/PageHeader.astro';
import PageHeader from '../components/PageHeaderScorecard.astro';
// import PageHeader from '../components/PageHeaderMagazine.astro';
import PageFooter from '../components/PageFooter.astro';
import TocSidePanel from '../components/TocSidePanel.astro';
import type { ActionContent, PageDifficulty, PageType } from '../utils/pageTypes.js';
import type { TocCategoryEntry } from '../utils/tocBuilder.js';
import type { PageSummary } from '../utils/pagesSummary.js';
import { booksConfig } from '../utils/pageConfig.js';
import { buildToc } from '../utils/tocBuilder.js';
import { buildPagesSummary } from '../utils/pagesSummary.js';

interface Props {
  title: string;
  currentPage?: number;
  answerKeyUrl?: string;
  bookId?: string;
  pageTitle?: string;
  pageDescription?: string;
  category?: string;
  difficulty?: PageDifficulty;
  actionContent?: ActionContent;
  itemCount?: number;
  pageType?: PageType;
  // Callers that already resolved the book's pages (e.g. [book]/[page].astro)
  // should pass these to avoid recomputing them — Layout only derives them
  // itself as a fallback for callers that don't (e.g. 404.astro).
  tocEntries?: TocCategoryEntry[];
  pagesSummary?: PageSummary[];
  totalPages?: number;
  // Whether this page's type gets a PageHeader/PageFooter at all — driven by
  // pageTypeRegistry.ts via [book]/[page].astro. Defaults to true so callers
  // that don't pass it (e.g. 404.astro) keep getting both, as before.
  showsHeader?: boolean;
  showsFooter?: boolean;
  // Site nav chrome (SiteHeader/SiteFooter/TocSidePanel). The /samples gallery
  // turns it off so each sample tile shows only the book page itself.
  showSiteChrome?: boolean;
}

const {
  title, currentPage = 1, answerKeyUrl, bookId = 'nfl', pageTitle, pageDescription,
  category, difficulty, actionContent, itemCount, pageType,
  tocEntries: tocEntriesProp, pagesSummary: pagesSummaryProp, totalPages: totalPagesProp,
  showsHeader = true, showsFooter = true, showSiteChrome = true,
} = Astro.props as Props;

const book = booksConfig[bookId];
const totalPages = totalPagesProp ?? book?.pages.length ?? 0;
const pagesSummary = pagesSummaryProp ?? (book ? buildPagesSummary(book.pages) : []);
const tocEntries = tocEntriesProp ?? (book ? buildToc(book.pages) : []);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title class="print:hidden">{title}</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-cream print:bg-white text-ink print:text-black font-body min-h-screen flex flex-col">
  <div id="app" class="flex flex-col flex-1 print:h-full">
    {showSiteChrome && <SiteHeader currentPage={currentPage} bookId={bookId} pages={pagesSummary} />}
    {showsHeader && (
      <PageHeader title={title} currentPage={currentPage} pageTitle={pageTitle} pageDescription={pageDescription} category={category} difficulty={difficulty} actionContent={actionContent} bookId={bookId} itemCount={itemCount} pageType={pageType} />
    )}
    <main class="flex-1 flex flex-col container mx-auto px-4 print:p-0 print:m-0 print:max-w-none print:justify-center">
      <slot />
    </main>
    {showSiteChrome && <SiteFooter currentPage={currentPage} totalPages={totalPages} />}
    {showsFooter && (
      <PageFooter currentPage={currentPage} answerKeyUrl={answerKeyUrl} />
    )}
  </div>
  {showSiteChrome && <TocSidePanel entries={tocEntries} bookId={bookId} currentPage={currentPage} />}
  
  <script define:vars={{ currentPage, totalPages, answerKeyUrl, bookId }}>
    window.bookAppConfig = {
      currentPage,
      totalPages,
      answerKeyUrl: answerKeyUrl || `https://example.com/page-${currentPage}-answers`,
      bookId
    };
  </script>
  <script src="/src/scripts/bookApp.ts"></script>
</body>
</html>