---
import Layout from '../layouts/Layout.astro';
import { pageConfig } from '../utils/pageConfig.js';
---

<Layout title="Page Not Found - Book Reader">
  <div class="bg-white border-2 border-ink p-8 max-w-4xl mx-auto">
    <h2 class="font-display uppercase text-2xl tracking-wide text-ink mb-4">Page Not Found</h2>
    <p class="text-mid">Sorry, the page you're looking for doesn't exist.</p>
    <a href="/1/" class="inline-block mt-4 bg-red hover:bg-red-dark text-cream font-display uppercase tracking-wide px-6 py-2 transition-colors duration-200">
      Go to Page 1
    </a>
  </div>
</Layout>