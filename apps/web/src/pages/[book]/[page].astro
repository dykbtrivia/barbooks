---
import Layout from '../../layouts/Layout.astro';
import { booksConfig } from '../../utils/pageConfig.js';
import { buildToc } from '../../utils/tocBuilder.js';
import { buildPagesSummary } from '../../utils/pagesSummary.js';
import { pageTypeRegistry } from '../../utils/pageTypeRegistry.js';
import type { GetStaticPaths } from 'astro';
import type { PageConfiguration } from '../../utils/pageTypes.js';

export const getStaticPaths: GetStaticPaths = () => {
  const paths: Array<{
    params: { book: string, page: string },
    props: { tocEntries: ReturnType<typeof buildToc>, pagesSummary: ReturnType<typeof buildPagesSummary> },
  }> = [];

  for (const [bookId, bookConfig] of Object.entries(booksConfig)) {
    // Computed once per book (not per page) — every page within a book shares
    // the same TOC and pages summary, so build them here and hand them down
    // via props rather than recomputing per generated page.
    const tocEntries = buildToc(bookConfig.pages);
    const pagesSummary = buildPagesSummary(bookConfig.pages);

    for (let i = 1; i <= bookConfig.pages.length; i++) {
      paths.push({
        params: { book: bookId, page: i.toString() },
        props: { tocEntries, pagesSummary },
      });
    }
  }

  return paths;
};

const { book, page } = Astro.params;
const { tocEntries, pagesSummary } = Astro.props;
const pageNumber: number = parseInt(page as string);
const bookId: string = book as string;

const bookConfig = booksConfig[bookId];

// If the book doesn't exist, redirect to NFL book page 1
if (!bookConfig) {
  return Astro.redirect('/nfl/1/');
}

if (!bookConfig.pageExists(pageNumber)) {
  return Astro.redirect(`/${bookId}/1/`);
}

const pageConfiguration: PageConfiguration = bookConfig.getPageConfiguration(pageNumber);
const answerKeyUrl: string = bookConfig.getAnswerKeyUrl(pageNumber);
const title: string = `${bookId.toUpperCase()} Book - Page ${pageNumber}`;
const pageType = pageConfiguration.type;
const totalPages = bookConfig.pages.length;

// The registry owns everything type-specific: which component renders this
// page, what props it needs, what goes in the header, and whether this type
// gets a header/footer at all. Adding a new page type means adding one entry
// to pageTypeRegistry.ts — this file doesn't change.
const entry = pageTypeRegistry[pageType];
const registryContext = { bookId, tocEntries };
const componentProps = entry.getComponentProps(pageConfiguration, registryContext);
const headerProps = entry.getHeaderProps(pageConfiguration);
const PageComponent = entry.component;
---

<Layout
  title={title}
  currentPage={pageNumber}
  answerKeyUrl={answerKeyUrl}
  bookId={bookId}
  pageTitle={headerProps.title}
  pageDescription={headerProps.description}
  category={headerProps.category}
  difficulty={headerProps.difficulty}
  itemCount={headerProps.itemCount}
  pageType={pageType}
  tocEntries={tocEntries}
  pagesSummary={pagesSummary}
  totalPages={totalPages}
  showsHeader={entry.showsHeader}
  showsFooter={entry.showsFooter}
>
  <div class="relative bg-white rounded-lg shadow-lg p-8 px-24 pt-2 max-w-4xl mx-auto print:bg-transparent print:shadow-none print:p-0 print:pt-0 print:max-w-none print:m-0 print:pb-0 print:rounded-none">
    <div class="prose prose-lg max-w-none">
      <PageComponent {...componentProps} />
    </div>
  </div>
</Layout>
