{
  "name": "barbooks-monorepo",
  "private": true,
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "install:scraper": "npm --prefix apps/scraper install",
    "dev:scraper": "cd apps/scraper && npm run dev",
    "start:scraper": "cd apps/scraper && npm start",
    "test:scraper": "cd apps/scraper && npm test",
    "dev:worker": "cd apps/worker && npx wrangler dev",
    "build:web": "cd apps/web && npm run build",
    "deploy:worker": "cd apps/worker && npx wrangler deploy",
    "sync-pages": "cd apps/web && npm run sync-pages",
    "generate-pdf": "cd apps/web && npm run generate-pdf",
    "samples-pdf": "cd apps/web && npm run samples-pdf",
    "og-image": "cd apps/web && npm run og-image"
  }
}
